# Production environment for the Vite web build.
# Only VITE_* variables are exposed to the browser bundle — never put secrets here.
# .env.production overrides .env at `vite build` time, so the deployed bundle
# bakes in the real Cloudflare Worker API URL instead of the localhost fallback.

VITE_API_URL=https://stable-sprint-api.cryptoflops-00.workers.dev
VITE_SCORE_REGISTRY_ADDRESS=0xc4c59f5D3a9dedE1203fFfe4e31841d88F61BDB5
VITE_BADGES_ADDRESS=0x367Aa832B18d298eABb0710B326E4e770182531F
VITE_CHAIN_ID=42220
